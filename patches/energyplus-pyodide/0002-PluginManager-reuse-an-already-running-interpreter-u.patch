From fd988683f1f930b45e023c4c64d72fb257bf1d51 Mon Sep 17 00:00:00 2001
From: browser-energy-simulation <noreply@localhost>
Date: Thu, 22 Oct 2026 14:02:40 -0600
Subject: [PATCH 2/4] PluginManager: reuse an already running interpreter under
 Emscripten

Inside Pyodide the interpreter is live before EnergyPlus loads. Py_InitializeFromConfig would reconfigure it and replace sys.path with python_lib, so return early from initPython when Py_IsInitialized().
---
 src/EnergyPlus/PythonHelpers.cc | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/EnergyPlus/PythonHelpers.cc b/src/EnergyPlus/PythonHelpers.cc
index 8438d58..0a8598a 100644
--- a/src/EnergyPlus/PythonHelpers.cc
+++ b/src/EnergyPlus/PythonHelpers.cc
@@ -105,6 +105,14 @@ namespace PythonHelpers {
 
     void initPython(EnergyPlus::EnergyPlusData &state, fs::path const &programDir)
     {
+#    ifdef __EMSCRIPTEN__
+        // In the browser, EnergyPlus is a side module loaded into an interpreter that is already running (Pyodide).
+        // Re-initializing from config would reconfigure that live interpreter and replace its sys.path with python_lib.
+        if (Py_IsInitialized() != 0) {
+            return;
+        }
+#    endif
+
         PyStatus status;
 
         // first pre-config Python so that it can speak UTF-8
